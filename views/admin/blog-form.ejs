<form action="/admin/blog/save" method="POST" class="admin-form">
  <% if (post) { %><input type="hidden" name="id" value="<%= post.id %>"><% } %>
  <div class="form-row triple">
    <div class="form-group"><label>Title (Arabic)</label><input type="text" name="title_ar" value="<%= post ? post.title_ar : '' %>" required></div>
    <div class="form-group"><label>Title (French)</label><input type="text" name="title_fr" value="<%= post ? post.title_fr : '' %>" required></div>
    <div class="form-group"><label>Title (English)</label><input type="text" name="title_en" value="<%= post ? post.title_en : '' %>" required></div>
  </div>
  <div class="form-group"><label>Slug</label><input type="text" name="slug" value="<%= post ? post.slug : '' %>"></div>
  <div class="form-group"><label>Content (Arabic)</label><textarea name="content_ar" rows="8"><%= post ? post.content_ar : '' %></textarea></div>
  <div class="form-group"><label>Content (French)</label><textarea name="content_fr" rows="8"><%= post ? post.content_fr : '' %></textarea></div>
  <div class="form-group"><label>Content (English)</label><textarea name="content_en" rows="8"><%= post ? post.content_en : '' %></textarea></div>
  <div class="form-check"><input type="checkbox" name="published" value="1" <%= !post || post.published ? 'checked' : '' %>> <label>Published</label></div>
  <div class="form-actions">
    <a href="/admin/blog" class="btn btn-outline">Cancel</a>
    <button type="submit" class="btn btn-primary">Save Post</button>
  </div>
</form>