<form action="/admin/pages/save" method="POST" class="admin-form">
  <% if (page) { %><input type="hidden" name="id" value="<%= page.id %>"><% } %>
  <div class="form-row triple">
    <div class="form-group"><label>Title (Arabic)</label><input type="text" name="title_ar" value="<%= page ? page.title_ar : '' %>" required></div>
    <div class="form-group"><label>Title (French)</label><input type="text" name="title_fr" value="<%= page ? page.title_fr : '' %>" required></div>
    <div class="form-group"><label>Title (English)</label><input type="text" name="title_en" value="<%= page ? page.title_en : '' %>" required></div>
  </div>
  <div class="form-group"><label>Slug</label><input type="text" name="slug" value="<%= page ? page.slug : '' %>"></div>
  <div class="form-group"><label>Content (Arabic)</label><textarea name="content_ar" rows="6"><%= page ? page.content_ar : '' %></textarea></div>
  <div class="form-group"><label>Content (French)</label><textarea name="content_fr" rows="6"><%= page ? page.content_fr : '' %></textarea></div>
  <div class="form-group"><label>Content (English)</label><textarea name="content_en" rows="6"><%= page ? page.content_en : '' %></textarea></div>
  <div class="form-check"><input type="checkbox" name="published" value="1" <%= !page || page.published ? 'checked' : '' %>> <label>Published</label></div>
  <div class="form-actions">
    <a href="/admin/pages" class="btn btn-outline">Cancel</a>
    <button type="submit" class="btn btn-primary">Save Page</button>
  </div>
</form>