<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
  <div>
    <h3 style="font-size:1rem;font-weight:700;margin-bottom:12px">New Flash Sale</h3>
    <form action="/admin/flash-sales/save" method="POST" class="admin-form">
      <div class="form-group"><label>Product</label><select name="product_id" required><% products.forEach(function(p) { %><option value="<%= p.id %>"><%= p.name_fr %> - <%= p.price %> DA</option><% }) %></select></div>
      <div class="form-group"><label>Discount (%)</label><input type="number" name="discount_percent" min="1" max="99" required></div>
      <div class="form-row">
        <div class="form-group"><label>Start Date</label><input type="datetime-local" name="start_date" required></div>
        <div class="form-group"><label>End Date</label><input type="datetime-local" name="end_date" required></div>
      </div>
      <div class="form-group"><label>Max Quantity</label><input type="number" name="max_quantity" placeholder="Unlimited"></div>
      <div class="form-check"><input type="checkbox" name="active" value="1" checked> <label>Active</label></div>
      <div class="form-actions"><button type="submit" class="btn btn-primary">Save</button></div>
    </form>
  </div>
  <div>
    <h3 style="font-size:1rem;font-weight:700;margin-bottom:12px">Active Flash Sales</h3>
    <div class="table-container">
      <table class="data-table">
        <thead><tr><th>Product</th><th>Discount</th><th>Period</th><th>Active</th><th></th></tr></thead>
        <tbody>
          <% if (sales.length === 0) { %><tr><td colspan="5" class="empty-cell">No flash sales</td></tr><% } %>
          <% sales.forEach(function(s) { %>
            <tr>
              <td><%= s.product_name %></td>
              <td><span class="badge badge-danger">-<%= s.discount_percent %>%</span></td>
              <td style="font-size:0.8rem"><%= new Date(s.start_date).toLocaleDateString() %> - <%= new Date(s.end_date).toLocaleDateString() %></td>
              <td><span class="badge <%= s.active ? 'badge-success' : 'badge-danger' %>"><%= s.active ? 'Yes' : 'No' %></span></td>
              <td><form action="/admin/flash-sales/delete/<%= s.id %>" method="POST"><button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete?')"><i class="fas fa-trash"></i></button></form></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>