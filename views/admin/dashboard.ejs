<div class="stats-grid">
  <div class="stat-card accent">
    <div class="stat-icon" style="color:var(--primary)"><i class="fas fa-shopping-bag"></i></div>
    <div class="stat-label">Total Orders</div>
    <div class="stat-value"><%= totalOrders %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="color:var(--green)"><i class="fas fa-money-bill-wave"></i></div>
    <div class="stat-label">Revenue</div>
    <div class="stat-value"><%= (totalRevenue || 0).toFixed(2) %> DA</div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="color:#2563eb"><i class="fas fa-box"></i></div>
    <div class="stat-label">Products</div>
    <div class="stat-value"><%= totalProducts %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="color:#7c3aed"><i class="fas fa-users"></i></div>
    <div class="stat-label">Customers</div>
    <div class="stat-value"><%= totalCustomers %></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="color:#059669"><i class="fas fa-calendar-day"></i></div>
    <div class="stat-label">Today's Orders</div>
    <div class="stat-value"><%= ordersToday %></div>
  </div>
  <div class="stat-card warning">
    <div class="stat-icon" style="color:#d97706"><i class="fas fa-exclamation-triangle"></i></div>
    <div class="stat-label">Low Stock</div>
    <div class="stat-value"><%= lowStock %></div>
  </div>
  <div class="stat-card danger">
    <div class="stat-icon" style="color:#dc2626"><i class="fas fa-times-circle"></i></div>
    <div class="stat-label">Out of Stock</div>
    <div class="stat-value"><%= outOfStock %></div>
  </div>
  <div class="stat-card warning">
    <div class="stat-icon" style="color:#d97706"><i class="fas fa-clock"></i></div>
    <div class="stat-label">Pending Orders</div>
    <div class="stat-value"><%= pendingOrders %></div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px">
  <div class="table-container">
    <div style="padding:16px;border-bottom:1px solid var(--gray-200)">
      <h3 style="font-size:1rem;font-weight:700">Recent Orders</h3>
    </div>
    <table class="data-table">
      <thead><tr><th>Order</th><th>Customer</th><th>Wilaya</th><th>Total</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% if (recentOrders.length === 0) { %><tr><td colspan="6" class="empty-cell">No orders yet</td></tr><% } %>
        <% recentOrders.forEach(function(o) { %>
          <tr>
            <td><a href="/admin/orders/<%= o.id %>"><%= o.order_number %></a></td>
            <td><%= o.full_name %></td>
            <td><%= o.wilaya || '' %></td>
            <td><%= o.total.toFixed(2) %> DA</td>
            <td><span class="status-badge <%= o.status %>"><%= o.status %></span></td>
            <td><a href="/admin/orders/<%= o.id %>" class="btn btn-sm btn-outline">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="table-container">
    <div style="padding:16px;border-bottom:1px solid var(--gray-200)">
      <h3 style="font-size:1rem;font-weight:700">Best Sellers</h3>
    </div>
    <table class="data-table">
      <thead><tr><th>Product</th><th>Sold</th></tr></thead>
      <tbody>
        <% if (bestSellers.length === 0) { %><tr><td colspan="2" class="empty-cell">No sales yet</td></tr><% } %>
        <% bestSellers.forEach(function(p) { %>
          <tr><td><%= p.name_fr || p.name_ar %></td><td><%= p.total_sold %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div style="display:flex;gap:12px;flex-wrap:wrap">
  <a href="/admin/products/new" class="btn btn-primary"><i class="fas fa-plus"></i> New Product</a>
  <a href="/admin/orders" class="btn btn-outline"><i class="fas fa-list"></i> All Orders</a>
  <a href="/admin/orders/export" class="btn btn-outline"><i class="fas fa-file-export"></i> Export Orders</a>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:24px">
  <div class="table-container">
    <div style="padding:16px;border-bottom:1px solid var(--gray-200)">
      <h3 style="font-size:1rem;font-weight:700">Monthly Revenue</h3>
    </div>
    <table class="data-table">
      <thead><tr><th>Month</th><th>Orders</th><th>Revenue</th></tr></thead>
      <tbody>
        <% if (monthlyStats.length === 0) { %><tr><td colspan="3" class="empty-cell">No sales data yet</td></tr><% } %>
        <% monthlyStats.forEach(function(m) { %>
          <tr><td><%= m.month %></td><td><%= m.orders %></td><td><%= Number(m.revenue).toFixed(2) %> DA</td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="table-container">
    <div style="padding:16px;border-bottom:1px solid var(--gray-200)">
      <h3 style="font-size:1rem;font-weight:700;color:#dc2626"><i class="fas fa-exclamation-triangle"></i> Low Stock Items</h3>
    </div>
    <table class="data-table">
      <thead><tr><th>Product</th><th>Stock</th></tr></thead>
      <tbody>
        <% if (lowStockItems.length === 0) { %><tr><td colspan="2" class="empty-cell">All products sufficiently stocked</td></tr><% } %>
        <% lowStockItems.forEach(function(p) { %>
          <tr>
            <td><a href="/admin/products/<%= p.id %>/edit"><%= p.name_fr || p.name_ar %></a></td>
            <td><span class="status-badge <%= p.stock === 0 ? 'danger' : 'warning' %>"><%= p.stock %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>