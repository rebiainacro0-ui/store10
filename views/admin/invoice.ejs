<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Invoice <%= order.order_number %></title>
<style>
body{font-family:sans-serif;padding:30px;max-width:800px;margin:0 auto}
.header{display:flex;justify-content:space-between;margin-bottom:32px}
.company h1{margin:0;font-size:1.8rem;color:#006633}
.company p{margin:2px 0;color:#666;font-size:0.85rem}
.invoice-title{text-align:right}
.invoice-title h2{margin:0;font-size:1.3rem}
table{width:100%;border-collapse:collapse;margin:24px 0}
th{background:#f5f5f5;padding:10px 12px;border:1px solid #ddd;font-size:0.85rem;text-transform:uppercase}
td{padding:10px 12px;border:1px solid #ddd}
.totals{text-align:right;margin-top:16px}
.totals p{margin:4px 0}
.grand-total{font-size:1.3rem;font-weight:700;color:#006633}
.footer{text-align:center;margin-top:40px;color:#999;font-size:0.8rem;border-top:1px solid #ddd;padding-top:16px}
@media print{body{padding:0}}
</style></head>
<body>
<div class="header">
  <div class="company">
    <h1>DZ Store</h1>
    <p>Alger, Algérie</p>
    <p>contact@dzstore.dz</p>
    <p>+213 21 123 456</p>
  </div>
  <div class="invoice-title">
    <h2>INVOICE</h2>
    <p><strong><%= order.order_number %></strong></p>
    <p><%= new Date(order.created_at).toLocaleDateString() %></p>
  </div>
</div>

<div style="margin-bottom:24px">
  <h3>Bill To:</h3>
  <p><strong><%= order.full_name %></strong></p>
  <p><%= order.phone %></p>
  <p><%= order.wilaya || '' %></p>
  <p><%= order.delivery_address %></p>
</div>

<table>
  <thead><tr><th>Description</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead>
  <tbody>
    <% items.forEach(function(item) { %>
      <tr><td><%= item.product_name_fr || item.product_name_ar %></td><td><%= item.price.toFixed(2) %> DA</td><td><%= item.quantity %></td><td><%= item.total.toFixed(2) %> DA</td></tr>
    <% }) %>
  </tbody>
</table>

<div class="totals">
  <p>Subtotal: <%= order.subtotal.toFixed(2) %> DA</p>
  <p>Shipping: <%= order.shipping > 0 ? order.shipping.toFixed(2) + ' DA' : 'Free' %></p>
  <% if (order.discount > 0) { %><p>Discount: -<%= order.discount.toFixed(2) %> DA</p><% } %>
  <p class="grand-total">Total: <%= order.total.toFixed(2) %> DA</p>
  <p style="font-size:0.85rem;color:#666">Payment: <%= order.payment_method.toUpperCase() %></p>
</div>

<div class="footer">
  <p>Thank you for your business!</p>
  <p>DZ Store - Algeria's Premier Online Store</p>
</div>
</body></html>